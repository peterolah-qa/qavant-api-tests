{
  "info": {
    "name": "Qavant — API Tests",
    "description": "REST API test suite by Peter (Qavant).\n\nFolders 1–4 exercise full CRUD + auth against restful-booker (https://restful-booker.herokuapp.com), a public practice API that is deliberately buggy — quirks are documented as inline NOTE comments so the expected-vs-conventional behaviour is explicit.\n\nFolder 5 is a production contract check against the live qavant.dev: status codes, security headers and cache policy — the HTTP layer beneath the UI suite.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 · Health check",
      "item": [
        {
          "name": "GET /ping (API up?)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ping"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API is reachable (201)', () => pm.response.to.have.status(201));",
                  "pm.test('responds under 2s', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 · Authentication",
      "item": [
        {
          "name": "POST /auth (get token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('token returned', () => pm.expect(j).to.have.property('token').that.is.a('string').with.length.above(0));",
                  "pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 · Booking CRUD (chained)",
      "item": [
        {
          "name": "CREATE · POST /booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{$randomFirstName}}\",\n  \"lastname\": \"{{$randomLastName}}\",\n  \"totalprice\": 222,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-01-01\",\n    \"checkout\": \"2026-01-07\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// NOTE: restful-booker returns 200 on create; 201 would be conventional (documented quirk).",
                  "pm.test('create returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('response matches booking schema', () => pm.response.to.have.jsonSchema({\"type\": \"object\", \"required\": [\"bookingid\", \"booking\"], \"properties\": {\"bookingid\": {\"type\": \"number\"}, \"booking\": {\"type\": \"object\", \"required\": [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\"], \"properties\": {\"firstname\": {\"type\": \"string\"}, \"lastname\": {\"type\": \"string\"}, \"totalprice\": {\"type\": \"number\"}, \"depositpaid\": {\"type\": \"boolean\"}, \"bookingdates\": {\"type\": \"object\", \"required\": [\"checkin\", \"checkout\"], \"properties\": {\"checkin\": {\"type\": \"string\"}, \"checkout\": {\"type\": \"string\"}}}}}}}));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('bookingId', j.bookingid);",
                  "pm.collectionVariables.set('createdFirstName', j.booking.firstname);",
                  "pm.test('echoes the price we sent', () => pm.expect(j.booking.totalprice).to.eql(222));"
                ]
              }
            }
          ]
        },
        {
          "name": "READ · GET /booking/{id}",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('returns the record we created', () => pm.expect(j.firstname).to.eql(pm.collectionVariables.get('createdFirstName')));",
                  "pm.test('responds under 2s', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ]
        },
        {
          "name": "UPDATE · PUT /booking/{id}",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Updated\",\n  \"lastname\": \"Booking\",\n  \"totalprice\": 500,\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"2026-02-01\",\n    \"checkout\": \"2026-02-05\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('firstname was updated', () => pm.expect(j.firstname).to.eql('Updated'));",
                  "pm.test('price was updated', () => pm.expect(j.totalprice).to.eql(500));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH · partial update",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Patched\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('only firstname changed', () => pm.expect(pm.response.json().firstname).to.eql('Patched'));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE · /booking/{id}",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// NOTE: restful-booker returns 201 on delete; 200/204 would be conventional (documented quirk).",
                  "pm.test('delete acknowledged (201)', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "VERIFY · GET deleted returns 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('record is gone (404)', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4 · Negative & known issues",
      "item": [
        {
          "name": "DELETE without auth → 403",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "1"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejects unauthenticated delete', () => pm.expect(pm.response.code).to.be.oneOf([403, 405]));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET non-existent id → 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking/99999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "99999999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('missing record returns 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5 · Production contract · qavant.dev",
      "item": [
        {
          "name": "Homepage 200 + security headers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://qavant.dev/",
              "protocol": "https",
              "host": [
                "qavant",
                "dev"
              ],
              "path": [
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('homepage is 200', () => pm.response.to.have.status(200));",
                  "pm.test('served as HTML', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'));",
                  "pm.test('HSTS enabled', () => pm.expect(pm.response.headers.get('Strict-Transport-Security')).to.be.a('string'));",
                  "pm.test('X-Frame-Options set', () => pm.expect(pm.response.headers.get('X-Frame-Options')).to.match(/SAMEORIGIN/i));",
                  "pm.test('nosniff set', () => pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.match(/nosniff/i));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown path returns 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://qavant.dev/__nope__",
              "protocol": "https",
              "host": [
                "qavant",
                "dev"
              ],
              "path": [
                "__nope__"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('missing page is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Fonts are immutably cached",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://qavant.dev/fonts/inter-v19-latin-ext_latin-regular.woff2",
              "protocol": "https",
              "host": [
                "qavant",
                "dev"
              ],
              "path": [
                "fonts",
                "inter-v19-latin-ext_latin-regular.woff2"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('font is 200', () => pm.response.to.have.status(200));",
                  "pm.test('long-lived cache header', () => pm.expect(pm.response.headers.get('Cache-Control') || '').to.match(/max-age|immutable/));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://restful-booker.herokuapp.com"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "password123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "createdFirstName",
      "value": ""
    }
  ]
}